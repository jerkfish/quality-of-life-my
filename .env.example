# Copy to .env and fill in. .env is gitignored; this file is committed and holds names only.
#
# Nothing here is required to build the site or run the pipeline — both read only the
# committed data artifacts. These are needed to publish artifacts to R2 and deploy the Worker.

# --- R2 (S3-compatible object storage) ----------------------------------------
# Used by `pipeline` to publish artifacts and by the Worker to read them.
# Create the token at: Cloudflare dashboard > R2 > Manage R2 API Tokens
# Give it Object Read & Write on the bucket below.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Cloudflare API -----------------------------------------------------------
# Used by wrangler to deploy the Worker and the Pages project.
# Create at: Cloudflare dashboard > My Profile > API Tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
